# Write your MySQL query statement below
SELECT e1.employee_id,e1.name,
COUNT(e2.employee_id) AS reports_count,#asked to count employee directed to
ROUND(AVG(e2.age)) AS average_age #avg age of reports asked that's why e2
FROM Employees e1
INNER JOIN Employees e2 
   on e1.employee_id=e2.reports_to 
GROUP BY e1.employee_id,e1.name#becoz e1.name is in select
ORDER BY e1.employee_id
