# Write your MySQL query statement below
SELECT m.name  #manager
FROM Employee e   #employee
JOIN Employee m
ON e.managerId=m.id
GROUP BY m.name,m.id
HAVING COUNT(e.id)>=5; #not m.id,we need how many employee


//without join ,using subquery
# Write your MySQL query statement below
SELECT name
FROM Employee
WHERE id IN   # don't use id=
(
    SELECT managerId 
FROM Employee
GROUP BY managerId
HAVING COUNT(DISTINCT id)>=5)

